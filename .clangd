---
If:
  PathMatch: [ 
    engine/(source)/.*\.h,
    engine/(source)/.*\.cpp,
    engine/(source)/.*\.cxx,
    (test|bench)/.*\.h,
    (test|bench)/.*\.cpp,
    (test|bench)/.*\.cxx,
  ]
Index:
  StandardLibrary: false
Completion:
  HeaderInsertion: Never
Diagnostics:
  UnusedIncludes: None
  Suppress: [
    module_decl_not_at_start,
    global_module_introducer_not_at_start
  ]
  
---
If:
  PathMatch: [
    engine/(platform|shader|external)/.*,
    (cmake|bin|lib|build|venv|opt)/.*,
  ]
Index:
  Background: Skip
Diagnostics:
  Suppress: ["*"]
