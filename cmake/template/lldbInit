settings append target.debug-file-search-paths @debug_path@
settings set target.env-vars MTL_DEBUG_LAYER=1
settings set target.env-vars MTL_DEBUG_LAYER_ERROR_MODE=assert
settings set target.env-vars MTL_DEBUG_LAYER_VALIDATE_LOAD_ACTIONS=1
settings set target.env-vars MTL_DEBUG_LAYER_VALIDATE_STORE_ACTIONS=1
