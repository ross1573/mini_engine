{
    "version": 10,
    "include": [ "default.json" ],
    "configurePresets": [
        {
            "name": "windows-vs",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "inherits": [ "default" ],
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/",
            "toolset": {
                "value": "v145,version=14.51",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "VC_VERSION_MIN": "1951",
                "VC_VERSION_MAX": "1959"
            }
        }
    ]
}