{
    "version": 10,
    "configurePresets": [
        {
            "name": "macos-clang",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@21/bin/clang++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos-clang",
            "configurePreset": "macos-clang"
        }
    ]
}