{
    "version": 10,
    "include": [
        "cmake/presets/settings.json",
        "cmake/presets/config.json",
        "cmake/presets/macos.json",
        "cmake/presets/windows.json"
    ],
    "configurePresets": [
        {
            "name": "macos-clang-debug",
            "inherits": [ "macos-clang", "settings", "shared", "test", "no-bench" ],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-clang-bench",
            "inherits": [ "macos-clang", "settings", "shared", "no-test", "bench" ],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "macos-clang-develop",
            "inherits": [ "macos-clang", "settings", "shared", "no-test", "no-bench" ],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop" }
        },
        {
            "name": "macos-clang-release",
            "inherits": [ "macos-clang", "settings", "shared", "no-test", "no-bench" ],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "macos-clang-mono",
            "inherits": [ "macos-clang", "settings", "mono", "no-test", "no-bench" ],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "windows-vs-debug",
            "inherits": [ "windows-vs", "settings", "shared", "test", "no-bench" ]
        },
        {
            "name": "windows-vs-bench",
            "inherits": [ "windows-vs", "settings", "shared", "no-test", "bench" ]
        },
        {
            "name": "windows-vs-develop",
            "inherits": [ "windows-vs", "settings", "shared", "no-test", "no-bench" ]
        },
        {
            "name": "windows-vs-release",
            "inherits": [ "windows-vs", "settings", "shared", "no-test", "no-bench" ]
        },
        {
            "name": "windows-vs-mono",
            "inherits": [ "windows-vs", "settings", "mono", "no-test", "no-bench" ]
        }
    ]
}